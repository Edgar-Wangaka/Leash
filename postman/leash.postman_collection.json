                  "pm.test(\"blocked\", () => { pm.expect(record.verdict).to.eql(\"block\"); pm.expect(record.status).to.eql(\"blocked\"); });",
                  "pm.test(\"for the unknown seller and the cap\", () => pm.expect(record.reasons).to.include.members([\"allowlist\", \"cap\"]));",
                  "pm.collectionVariables.set(\"blockedRequestId\", record.request_id);"
                ]
