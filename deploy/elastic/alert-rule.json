{
  "name": "Leash: agent blocked 3+ times in 10 minutes",
  "rule_type_id": ".es-query",
  "consumer": "stackAlerts",
  "schedule": { "interval": "1m" },
  "params": {
    "searchType": "esQuery",
    "index": ["leash-decisions*"],
    "timeField": "@timestamp",
    "esQuery": "{\"query\":{\"term\":{\"event\":\"decision.blocked\"}}}",
    "aggType": "count",
    "groupBy": "top",
    "termField": "agent_id",
    "termSize": 10,
    "threshold": [2],
    "thresholdComparator": ">",
    "timeWindowSize": 10,
    "timeWindowUnit": "m",
    "size": 20
  },
  "actions": []
}
