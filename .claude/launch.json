{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "leash-dashboard",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "leash.dashboard"
      ],
      "port": 8787
    },
    {
      "name": "leash-dashboard-dry-run",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "DRY_RUN=true",
        "LEASH_DASHBOARD_PORT=8788",
        "LEASH_DB_PATH=leash-dry-run.db",
        "PAYOUTS_DB_PATH=payouts-dry-run.db",
        ".venv/bin/python",
        "-m",
        "leash.dashboard"
      ],
      "port": 8788
    },
    {
      "name": "leash-dashboard-local-only",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "DRY_RUN=true",
        "LEASH_DASHBOARD_PORT=8789",
        "LEASH_DB_PATH=leash-local-only.db",
        "PAYOUTS_DB_PATH=payouts-local-only.db",
        "DATABASE_URL=",
        "DATABASE_URL_UNPOOLED=",
        "LEASH_SETTINGS_DATABASE_URL=",
        "LEASH_SETTINGS_DATABASE_URL_UNPOOLED=",
        "LEASH_DEMO_TOKEN=local-judge-token-0001",
        "PYTHONPATH=src",
        ".venv/bin/python",
        "-m",
        "leash.dashboard"
      ],
      "port": 8789
    },
    {
      "name": "leash-dashboard-accounts-test",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "DRY_RUN=true",
        "LEASH_DASHBOARD_PORT=8790",
        "PYTHONPATH=src",
        "LEASH_DB_PATH=leash-accounts-test.db",
        "PAYOUTS_DB_PATH=payouts-accounts-test.db",
        "DATABASE_URL=",
        "DATABASE_URL_UNPOOLED=",
        "LEASH_SETTINGS_DATABASE_URL=",
        "LEASH_SETTINGS_DATABASE_URL_UNPOOLED=",
        ".venv/bin/python",
        "-m",
        "leash.dashboard"
      ],
      "port": 8790
    }
  ]
}
